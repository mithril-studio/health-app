[Unit]
Description=Team-Endurance local scheduler relay
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=boxd
Group=boxd
WorkingDirectory=/opt/team-endurance
EnvironmentFile=/opt/team-endurance/.env
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Europe/Amsterdam
ExecStart=/opt/team-endurance/ops/.venv/bin/python /opt/team-endurance/ops/relay.py
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=75 78
TimeoutStopSec=20
StandardOutput=append:/opt/team-endurance/state/relay.log
StandardError=append:/opt/team-endurance/state/relay.log
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/team-endurance/state
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
