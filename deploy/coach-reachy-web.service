[Unit]
Description=Coach Reachy dashboard
After=network-online.target coach-reachy-api.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=boxd
Group=boxd
WorkingDirectory=/opt/coach-reachy/web
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/local/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
