# Install/run from backend/, or pass the root environment via systemd EnvironmentFile.
# Never commit a populated environment. Empty credentials disable the integration.
DATABASE_URL=postgresql://coach_reachy:replace-with-db-password@127.0.0.1:5432/coach_reachy
APP_ORIGIN=https://coach-reachy.example.com
APP_PASSWORD=
# Each entry point has a separate credential. Generate independent random 32-byte values.
API_AUTH_TOKEN=
MCP_AUTH_TOKEN=
BOX_SHARED_SECRET=
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Existing live coaching provider; keep its credentials on the server.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k3
AGENT_TIMEOUT_SECONDS=150
AGENT_MAX_TOKENS=8192
AGENT_MAX_ROUNDS=6
AGENT_MAX_TOOLS=16
AGENT_RESULT_CHARS=80000
SYNC_INTERVAL_SECONDS=300
BACKGROUND_ENABLED=true
TZ=Europe/Amsterdam
