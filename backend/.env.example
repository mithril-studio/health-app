# Install/run from backend/, or pass the root environment via systemd EnvironmentFile.
# Never commit a populated environment. Empty credentials disable the integration.
DATABASE_URL=postgresql://coach_reachy:replace-with-db-password@127.0.0.1:5432/coach_reachy
APP_ORIGIN=https://coach-reachy.example.com
APP_PASSWORD=
# Each entry point has a separate credential. Generate independent random 32-byte values.
API_AUTH_TOKEN=
MCP_AUTH_TOKEN=
BOX_SHARED_SECRET=
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# auto chooses API with a key, otherwise the official Claude CLI. Never spoofs OAuth clients.
CLAUDE_TRANSPORT=auto
ANTHROPIC_API_KEY=
ANTHROPIC_OAUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-4-6
CLAUDE_CLI_PATH=claude
# Optional dedicated directory with refreshable official CLI login (.credentials.json).
# For the provisioned VM use /home/boxd/.claude. Keep directory 0700, credentials 0600.
CLAUDE_CONFIG_DIR=
CLAUDE_CLI_TIMEOUT=150
AGENT_MAX_ROUNDS=6
AGENT_MAX_TOOLS=16
SYNC_INTERVAL_SECONDS=300
BACKGROUND_ENABLED=true
TZ=Europe/Amsterdam
